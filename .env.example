# Application Config
TOP_K_ITEMS=3
PRICE_THRESHOLD=1000.0

# SharePoint Config
SHAREPOINT_SITE_URL=https://gulfcraft.sharepoint.com/sites/costing
SHAREPOINT_CLIENT_ID=your_client_id
SHAREPOINT_CLIENT_SECRET=your_client_secret
SHAREPOINT_LIST_NAME=CostingJobs

# D365 Config
D365_API_URL=https://gulfcraft.operations.dynamics.com
D365_TENANT_ID=your_tenant_id
D365_CLIENT_ID=your_d365_client_id
D365_CLIENT_SECRET=your_d365_client_secret

# Vendor Config
VENDOR_DEFAULT_EMAIL=vendor@example.com

# Email Config
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=costing-bot@gulfcraft.com
SMTP_PASSWORD=your_password

# Database Config
DATABASE_URL=sqlite:///./gulfcraft.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/gulfcraft

# Database Transfer (used by scripts/transfer_db.py)
# SOURCE_DATABASE_URL=postgresql+psycopg2://user:password@source-server.postgres.database.azure.com:5432/gulfcraft?sslmode=require
# DEST_DATABASE_URL=postgresql+psycopg2://user:password@dest-server.postgres.database.azure.com:5432/gulfcraft?sslmode=require

# Embedding Config
OPENAI_API_TYPE=azure
OPENAI_API_KEY=your_azure_key
OPENAI_API_VERSION=2023-05-15
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=text-embedding-3-small

# Security
SECRET_KEY=your_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Templates
COSTING_TEMPLATE_PATH=templates/costing_template.xlsx

# Langfuse
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Azure Mistral Document AI
AZURE_MISTRAL_ENDPOINT=https://<deployment-name>.<region>.models.ai.azure.com
AZURE_MISTRAL_API_KEY=your_azure_mistral_key
